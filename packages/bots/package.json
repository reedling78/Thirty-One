{
  "name": "@thirtyone/bots",
  "version": "0.0.0",
  "private": true,
  "description": "Computer opponents for Thirty-One. See only a player's view, never the full game state.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "@thirtyone/rules": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@thirtyone/tsconfig": "workspace:*",
    "eslint": "^9.39.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.3"
  }
}
