  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@thirtyone/tsconfig": "workspace:*",
    "eslint": "^9.39.0",
    "fast-check": "^4.10.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.3"
  }
